FROM maven:3.9.11-eclipse-temurin-17 AS build
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
ENV MAVEN_OPTS="-Xmx512m"
RUN chmod +x mvnw && ./mvnw -B package -DskipTests
RUN javac -d /tmp infra/Healthcheck.java

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/educore-identity/target/educore-identity-0.1.0-SNAPSHOT.jar /app/identity.jar
COPY --from=build --chown=10001:10001 /workspace/educore-academics/target/educore-academics-0.1.0-SNAPSHOT.jar /app/academics.jar
COPY --from=build --chown=10001:10001 /workspace/educore-finance/target/educore-finance-0.1.0-SNAPSHOT.jar /app/finance.jar
COPY --from=build --chown=10001:10001 /workspace/educore-communication/target/educore-communication-0.1.0-SNAPSHOT.jar /app/communication.jar
COPY --from=build --chown=10001:10001 /workspace/api-gateway/target/api-gateway-0.1.0-SNAPSHOT.jar /app/gateway.jar
COPY --from=build --chown=10001:10001 /tmp/Healthcheck.class /app/Healthcheck.class
COPY --from=build --chown=10001:10001 /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf /app/DejaVuSans.ttf
COPY --chown=10001:10001 infra/start-render-service.sh /app/start-render-service.sh
RUN chmod 0555 /app/start-render-service.sh
USER 10001:10001
ENV JAVA_TOOL_OPTIONS="-Xms32m -Xmx192m -Duser.timezone=Africa/Lagos"
ENV PORT=10000
ENV SERVER_PORT=10000
ENV EDUCORE_PDF_FONT=/app/DejaVuSans.ttf
EXPOSE 10000
HEALTHCHECK --interval=5s --timeout=4s --start-period=45s --retries=20 CMD ["java", "-cp", "/app", "Healthcheck"]
ENTRYPOINT ["/app/start-render-service.sh"]
